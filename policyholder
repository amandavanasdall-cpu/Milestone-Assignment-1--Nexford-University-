class Policyholder:
    def __init__(self, policyholder_id, name):
        self.policyholder_id = policyholder_id
        self.name = name
        self.active=True
        self.product = None
        self.payment_status = "Not Paid"

    # Register Policyholder
    def register_policyholder(self):
        self.active = True
        print(f"{self.name} has been registered as a policyholder.") 

    # Suspend Policyholder
    def suspend_policyholder(self):
        self.active = False
        print(f"{self.name} has been suspended as a policyholder.")

    # Reactivate policyholder
    def reactivate_policyholder(self):
        self.active = True
        print(f"{self.name} has been reactivated as a policyholder.")
        
    # Assign product to policyholder
    def assign_product(self, product):
        self.product = product
    
    # Display policyholder account details
    def display_account_details(self):
        print("--------------------")
        print(f"Policyholder ID: {self.policyholder_id}")   
        print("Name:", self.name)

        if self.active: 
            print("Status: Active")
        else:
            print("Status: Suspended")

        if self.products:
            print("Products:", self.products)
        else:
            print("Products: None")

        print("Payment Status:", self.payment_status)
        print("--------------------") 


        